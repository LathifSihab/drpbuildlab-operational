# Copy to .env for local development. Never commit .env.

# ---------- SvelteKit app ----------
# Staging/production: set with `wrangler secret put <NAME> --env staging` (or in the Cloudflare dashboard).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                      # Access application audience (AUD) tag
BOOTSTRAP_ADMIN_EMAIL=              # gets the admin role on first sign-in; everyone else starts as business
TRIGGER_SECRET_KEY=                 # Trigger.dev secret key of the matching environment (dev / staging / prod)
# TRIGGER_API_URL=https://api.trigger.dev
# Local dev only (ignored in deployed builds):
DEV_USER_EMAIL=                     # signed-in user when there is no Cloudflare Access header
DATABASE_URL=                       # Neon `dev` branch connection string (staging/prod use the Hyperdrive binding)
# Phase 2+: secrets manager (docs/ARCHITECTURE.md, Project secrets)
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=

# ---------- Trigger.dev tasks (set per environment in the Trigger.dev dashboard) ----------
TRIGGER_PROJECT_REF=                # proj_... (also used by trigger.config.ts and CI)
# DATABASE_URL=                     # Neon branch connection string for that environment
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_CERT_PEM=                 # or MS_CLIENT_SECRET
INTAKE_MAILBOX=projects-staging@drpbuildlab.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=drp-ops-staging
GITHUB_TOKEN=                       # now: personal account token (repo create + contents)
GITHUB_APP_ID=                      # later: GitHub App on the DRP org
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=                       # personal account now, org later
GITHUB_TEMPLATE_REPO=drp-sveltekit-template
