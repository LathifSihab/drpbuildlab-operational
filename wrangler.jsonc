{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level = local development (`npm run dev`). Locally the app uses DATABASE_URL from .env;
	// staging and production use the Hyperdrive binding (docs/SETUP.md, Cloudflare).
	"name": "drp-operational-dev",
	"compatibility_date": "2026-11-11",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"env": {
		"staging": {
			"name": "drp-operational-staging",
			"workers_dev": false,
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ee76545cf0d847a2b2087b89b13b3ec3" }],
			"r2_buckets": [{ "binding": "FILES", "bucket_name": "drp-ops-staging" }],
			"vars": { "APP_ENV": "staging" }
		},
		"production": {
			"name": "drp-operational-production",
			"workers_dev": false,
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_ID" }],
			"r2_buckets": [{ "binding": "FILES", "bucket_name": "drp-ops-prod" }],
			"vars": { "APP_ENV": "production" }
		}
	},
	"vars": { "APP_ENV": "development" }
}
